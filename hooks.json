{
  "token-saver-read": {
    "PreToolUse": [
      {
        "matcher": "read_file|view_file",
        "hooks": [
          {
            "type": "command",
            "command": "perl ./scripts/read_hook.pl",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "token-saver-write": {
    "PreToolUse": [
      {
        "matcher": "write_file|write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "perl ./scripts/write_hook.pl",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "token-saver-find": {
    "PreToolUse": [
      {
        "matcher": "find_by_name|find",
        "hooks": [
          {
            "type": "command",
            "command": "perl ./scripts/find_hook.pl",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "token-saver-grep": {
    "PreToolUse": [
      {
        "matcher": "grep_search",
        "hooks": [
          {
            "type": "command",
            "command": "perl ./scripts/grep_hook.pl",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "token-saver-post-edit": {
    "PostToolUse": [
      {
        "matcher": "edit_file|write_file|replace_file_content|multi_replace_file_content|write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "perl ./scripts/post_edit_hook.pl",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "token-saver-alerts": {
    "PostInvocation": [
      {
        "type": "command",
        "command": "perl ./scripts/post_invocation_alerts.pl",
        "timeout": 5
      }
    ]
  },
  "token-saver-telemetry": {
    "Stop": [
      {
        "type": "command",
        "command": "perl ./scripts/stop_telemetry.pl",
        "timeout": 5
      }
    ]
  }
}
