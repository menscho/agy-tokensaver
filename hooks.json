{
  "token-saver-session-start": {
    "SessionStart": [
      {
        "type": "command",
        "command": "python3 -S ./scripts/session_start_hook.py",
        "timeout": 5
      }
    ]
  },
  "token-saver-read": {
    "PreToolUse": [
      {
        "matcher": "read_file|view_file",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -S ./scripts/read_hook.py",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "token-saver-write": {
    "PreToolUse": [
      {
        "matcher": "write_file|write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -S ./scripts/write_hook.py",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "token-saver-find": {
    "PreToolUse": [
      {
        "matcher": "find_by_name|find",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -S ./scripts/find_hook.py",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "token-saver-grep": {
    "PreToolUse": [
      {
        "matcher": "grep_search",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -S ./scripts/grep_hook.py",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "token-saver-post-edit": {
    "PostToolUse": [
      {
        "matcher": "edit_file|write_file|replace_file_content|multi_replace_file_content|write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -S ./scripts/post_edit_hook.py",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "token-saver-handoff": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 -S ./scripts/pre_invocation_handoff.py",
        "timeout": 15
      }
    ]
  },
  "token-saver-alerts": {
    "PostInvocation": [
      {
        "type": "command",
        "command": "python3 -S ./scripts/post_invocation_alerts.py",
        "timeout": 5
      }
    ]
  },
  "token-saver-telemetry": {
    "Stop": [
      {
        "type": "command",
        "command": "python3 -S ./scripts/stop_telemetry.py",
        "timeout": 5
      }
    ]
  }
}
