# Keep vendored bundles byte-exact across Windows/macOS/Linux checkouts
mcp_app/vendor/** -text
*.zip binary
*.png binary
*.jpg binary

# Keep scripts and tests on LF so bash/perl/checksums behave identically across OSes
*.sh text eol=lf
*.pl text eol=lf
*.pm text eol=lf
*.py text eol=lf
*.command text eol=lf
*.svg text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.bat text eol=crlf
